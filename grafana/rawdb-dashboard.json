    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "panels": [],
      "title": "Overview",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Apdex score (satisfied T=0.5s, tolerating up to 2s). Frustrated requests include all 5xx responses regardless of latency, so they sit in the denominator but contribute 0 to the numerator. Total uses the `+Inf` bucket — robust against any `_count`/`_count_total` naming variation in the OTel→Prometheus exporter.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "decimals": 0,
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": 0
              },
              {
                "color": "yellow",
                "value": 0.5
              },
              {
                "color": "green",
                "value": 0.85
              }
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 3,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "percentChangeColorMode": "standard",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "pluginVersion": "12.4.3",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "(\n  sum(increase(rawdb_core_http_requests_duration_bucket{le=\"0.5\", status_code!~\"5..\"}[$__range]))\n  +\n  0.5 * (sum(increase(rawdb_core_http_requests_duration_bucket{le=\"2.0\", status_code!~\"5..\"}[$__range]))\n   -\n  sum(increase(rawdb_core_http_requests_duration_bucket{le=\"0.5\", status_code!~\"5..\"}[$__range])))\n)\n/\nsum(increase(rawdb_core_http_requests_duration_bucket{le=\"+Inf\"}[$__range]))",
          "instant": true,
          "legendFormat": "Apdex",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Apdex (T=0.5s)",
      "type": "stat"
    },
    {
      "datasource": {
