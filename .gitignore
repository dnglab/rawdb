backend/target
**/*.rs.bk
Cargo.lock.bak

# Frontend
node_modules/
dist/
.vite/
*.local
# Stray vue-tsc declaration-emit artifacts that sit next to the .vue
# sources — nothing imports them, but they shadow stale role/string
# values when present and have caused real bugs (see admin role rename).
frontend/src/**/*.vue.js

# Yarn 4 (node-modules linker): keep yarn.lock + .yarnrc.yml, drop the rest
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
.pnp.*

# Local runtime
/tmp/
/rawdb-cache/

# Editor
.vscode/
.idea/
*.swp

# Env
.env
.env.local

.dev/garage/data/
.dev/garage/meta/

